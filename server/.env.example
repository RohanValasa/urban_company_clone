# Copy to server/.env and fill in.

PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/servify
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Web client ID from Google Cloud Console (APIs & Services > Credentials),
# with http://localhost:5173 as an authorised JavaScript origin. The client
# fetches it from /api/config. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
# Where the React app runs. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173
# Your UPI ID (like yourname@okbank) for the "UPI (scan QR)" payment option,
# and the name shown in the payer's app. Leave empty to hide the QR code.
# Customers scan a QR for this ID at checkout, and professionals show it when
# collecting payment at the door.
UPI_ID=
UPI_NAME=Servify
# AI features: the "Ask Servify AI" assistant (photo, voice and text to a
# booking) and the spare-part fair price check. Pick a provider by adding its key:
#  - Gemini (Google AI Studio, aistudio.google.com) has a free tier.
#  - Claude (console.anthropic.com) is pay-as-you-go; it also checks new
#    professionals' ID photos.
# With no key, a free keyword-based "basic mode" answers (no photos), and it
# also steps in whenever the AI is out of quota or unreachable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: a different Gemini model for the parts price check.
GEMINI_PARTS_MODEL=
ANTHROPIC_API_KEY=
# Which Claude model each AI feature uses. Haiku is about 40x cheaper than Opus;
# Opus is more accurate with photos and prices.
AI_MODEL=claude-haiku-5-5
AI_PARTS_MODEL=claude-opus-5-5
# Force a provider: gemini, claude or basic. Empty: Gemini if its key is set,
# then Claude, else basic.
AI_PROVIDER=
# AI requests each account may make per hour (each one costs money).
AI_RATE_LIMIT=30
# Encrypts professionals' bank account numbers. Defaults to JWT_SECRET; set its
# own long random value in production (changing it later makes saved numbers unreadable).
FIELD_KEY=
# Seconds a professional has to accept a request before it moves on.
OFFER_SECONDS=90
# Seconds a customer waits before searching again when nobody accepted.
RETRY_COOLDOWN_SECONDS=120
