# Copy to server/.env and fill in.

PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/servify
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Web client ID from Google Cloud Console (APIs & Services > Credentials),
# with http://localhost:5173 as an authorised JavaScript origin. The client
# fetches it from /api/config. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
# Where the React app runs. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173
